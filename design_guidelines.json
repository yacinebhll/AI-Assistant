    },
    "doctor_profile": {
      "url": "https://images.unsplash.com/photo-1615177393114-bd2917a4f74a?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1Nzh8MHwxfHNlYXJjaHwyfHxkb2N0b3IlMjBwcm9mZXNzaW9uYWwlMjBwb3J0cmFpdCUyMGhvc3BpdGFsfGVufDB8fHx8MTc2NzUzMjYyMXww&ixlib=rb-4.1.0&q=85",
      "alt": "Doctor Profile",
      "usage": "User profile placeholder"
    }
  },
  "icons": {
    "library": "lucide-react",
    "style": "stroke-width={1.5} className='w-5 h-5'"
  },
  "motion": {
    "library": "framer-motion",
    "transitions": {
      "default": { "type": "spring", "stiffness": 300, "damping": 30 },
      "page": { "duration": 0.3, "ease": "easeInOut" }
    }
  },
  "instructions_to_main_agent": [
    "1. SETUP: Install 'lucide-react', 'recharts', 'framer-motion', 'clsx', 'tailwind-merge' if not present.",
    "2. THEME: Update 'tailwind.config.js' and 'index.css' with the provided color palette. Ensure Dark Mode is class-based.",
    "3. FONTS: Add the Google Fonts links to 'index.html' or import in CSS.",
    "4. LAYOUT: Create a 'Layout' component with a Sidebar (collapsible) and a Topbar (Glassmorphism).",
    "5. DASHBOARD: Implement the 'Control Room' grid. Use Recharts for data. Cards should be clean with subtle borders.",
    "6. ASSISTANT: Build a chat interface. Use the 'assistant_avatar' image. Messages should be bubbled with distinct colors (User: Primary/10, AI: Muted).",
    "7. DOCUMENTS: Use a Data Table (Shadcn compatible). Add row hover effects.",
    "8. AUTH: Create a split-screen Login page. Left: Form, Right: 'login_bg' image with a quote overlay.",
    "9. ACCESSIBILITY: Ensure all inputs have labels, images have alt text, and colors meet contrast ratios (checked in palette)."
  ],
  "UNIVERSAL_GUIDELINES_FOR_MAIN_AGENT": [
    "DO NOT use gradients for backgrounds unless specified (use solid colors or subtle noise).",
    "DO NOT center text in cards unless it's a specific 'Stat' card.",
    "ALWAYS use 'data-testid' for interactive elements.",
    "ALWAYS use 'sonner' for toasts.",
    "Use 'clsx' and 'tailwind-merge' for dynamic class names.",
    "Keep the interface 'Breathable' - avoid cluttering the dashboard."
  ]
}
{
  "identity": {
    "name": "E1 - The Anti-AI Designer",
    "mission": "Create a 'Clinical Zen' interface that balances medical precision with human warmth. Avoid the sterile 'hospital software' look.",
    "principles": [
      "Fusion: Linear meets Healthcare",
      "Emotion: Calm, Trust, Intelligence",
      "Content: Data clarity is paramount",
      "Negative Space: High density data needs breathing room"
    ]
  },
  "typography": {
    "fonts": [
      {
        "family": "Plus Jakarta Sans",
        "url": "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap",
        "usage": "Headings, Navigation, Buttons",
        "fallback": "sans-serif"
      },
      {
        "family": "Inter",
        "url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap",
        "usage": "Body text, Data tables, Inputs",
        "fallback": "sans-serif"
      },
      {
        "family": "JetBrains Mono",
        "url": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap",
        "usage": "Medical Codes, IDs, Logs",
        "fallback": "monospace"
      }
    ],
    "rules": {
      "h1": "font-sans font-bold text-4xl tracking-tight text-foreground",
      "h2": "font-sans font-semibold text-2xl tracking-tight text-foreground/90",
      "h3": "font-sans font-medium text-xl text-foreground/80",
      "body": "font-body text-base leading-relaxed text-muted-foreground",
      "small": "font-body text-sm text-muted-foreground/80",
      "code": "font-mono text-xs bg-muted px-1 py-0.5 rounded text-foreground"
    }
  },
  "colors": {

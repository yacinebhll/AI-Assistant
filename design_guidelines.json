        "destructive": "0 62.8% 30.6%",
        "destructive-foreground": "210 40% 98%",
        "border": "217 33% 17%",
        "input": "217 33% 17%",
        "ring": "199 89% 48%",
        "chart-1": "199 89% 48%",

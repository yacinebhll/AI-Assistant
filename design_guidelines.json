    "semantic": {
      "brand": "Teal-Blue (Intelligence, Calm)",
      "success": "Emerald (Positive outcomes)",
      "warning": "Amber (Alerts)",
      "error": "Rose (Critical errors)",
      "info": "Sky (Information)"
    }
  },
  "layout": {
    "grid": {
      "dashboard": "grid grid-cols-1 md:grid-cols-12 gap-6",
      "cards": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    },
    "spacing": {
      "container": "p-6 md:p-8 lg:p-10",
      "section": "py-12",
      "element": "gap-4"
    },
    "radius": {
      "default": "0.5rem",
      "button": "0.5rem",
      "card": "0.75rem"
    }
  },
  "components": {
    "Button": {
      "default": "rounded-md font-medium transition-all active:scale-95",
      "primary": "bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm",
      "ghost": "hover:bg-accent/10 hover:text-accent"
    },
    "Card": {
      "style": "bg-card text-card-foreground border border-border shadow-sm hover:shadow-md transition-shadow duration-200 rounded-xl"
    },
    "Input": {
      "style": "bg-background border-input focus:ring-2 focus:ring-primary/20 transition-all rounded-md"
    },
    "Sidebar": {
      "style": "bg-card/80 backdrop-blur-xl border-r border-border"
    }
  },
  "images": {
    "login_bg": {
      "url": "https://images.unsplash.com/photo-1682684123154-c21854fd90cf?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1Nzd8MHwxfHNlYXJjaHwzfHxtZWRpY2FsJTIwdGVjaG5vbG9neSUyMGFic3RyYWN0JTIwbWluaW1hbGlzdHxlbnwwfHx8fDE3Njc1MzI2MTl8MA&ixlib=rb-4.1.0&q=85",

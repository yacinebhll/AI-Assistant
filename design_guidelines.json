      "url": "https://images.pexels.com/photos/5215017/pexels-photo-5215017.jpeg",
      "alt": "AI Medical Assistant Avatar",
      "usage": "Chat interface avatar, Welcome screen"
    },
    "team_placeholder": {
      "url": "https://images.unsplash.com/photo-1755189118414-14c8dacdb082?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1Nzh8MHwxfHNlYXJjaHwxfHxkb2N0b3IlMjBwcm9mZXNzaW9uYWwlMjBwb3J0cmFpdCUyMGhvc3BpdGFsfGVufDB8fHx8MTc2NzUzMjYyMXww&ixlib=rb-4.1.0&q=85",
